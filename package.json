{
  "name": "dev-orchestra",
  "version": "3.0.0",
  "type": "module",
  "description": "Plan with a strong model, build with a cheap swarm: an MCP server that runs slices of a feature through a gate and a local commit.",
  "bin": {
    "dev-orchestra": "bin/dev-orchestra.mjs"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.test.js",
    "setup",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && npm --prefix web run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node dist/index.js --selftest && node --test --test-concurrency=1 dist/runs.test.js dist/hub.test.js dist/ui-assumir.test.js dist/ui-canvas.test.js dist/ui-agentes.test.js dist/ui-agentes-f21.test.js dist/ui-agentes-reconecta.test.js dist/ui-agentes-reiniciar.test.js dist/ui-cli.test.js dist/ui-ceder.test.js dist/ui-browser.test.js dist/ui-claude.test.js dist/ui-claude-env.test.js dist/ui-acoes-run.test.js dist/ui-g3.test.js dist/g3-agente.test.js dist/ui-arvore-projeto.test.js dist/guarda-escrita.test.js dist/s1-sem-reparo.test.js dist/s2-sem-feature.test.js dist/s3-dashboard.test.js dist/s4-setup.test.js dist/s6-pacote.test.js dist/s7-gate-timeout.test.js && node --experimental-strip-types --test canvas.test.ts canvas-texto.test.ts agentes.test.ts contexto.test.ts agentes-delta.test.ts colaboracao.test.ts cli.test.ts cli-sh.test.ts navegador.test.ts claude-pty.test.ts cli-browser.test.ts acoes-run.test.ts instrucoes.test.ts canvas-fases.test.ts && npm --prefix web test",
    "test:runs": "tsc && node --test dist/runs.test.js",
    "test:hub": "tsc && node --test dist/hub.test.js",
    "test:assumir": "tsc && node --test dist/ui-assumir.test.js",
    "test:canvas-modelo": "node --experimental-strip-types --test canvas.test.ts",
    "test:canvas-hub": "tsc && node --test dist/ui-canvas.test.js",
    "test:canvas-texto": "node --experimental-strip-types --test canvas-texto.test.ts",
    "test:agentes": "node --experimental-strip-types --test agentes.test.ts",
    "test:contexto": "node --experimental-strip-types --test contexto.test.ts",
    "test:agentes-hub": "tsc && node --test dist/ui-agentes.test.js",
    "test:agentes-delta": "node --experimental-strip-types --test agentes-delta.test.ts",
    "test:agentes-f21": "tsc && node --test dist/ui-agentes-f21.test.js",
    "test:agentes-reconecta": "tsc && node --test dist/ui-agentes-reconecta.test.js",
    "test:agentes-reiniciar": "tsc && node --test dist/ui-agentes-reiniciar.test.js",
    "test:colab": "node --experimental-strip-types --test colaboracao.test.ts",
    "test:cli-hub": "tsc && node --test dist/ui-cli.test.js",
    "test:cli": "node --experimental-strip-types --test cli.test.ts",
    "test:ceder": "tsc && node --test dist/ui-ceder.test.js",
    "test:cli-sh": "node --experimental-strip-types --test cli-sh.test.ts",
    "test:navegador": "node --experimental-strip-types --test navegador.test.ts",
    "test:claude-pty": "node --experimental-strip-types --test claude-pty.test.ts",
    "test:browser-hub": "tsc && node --test dist/ui-browser.test.js",
    "test:claude-hub": "tsc && node --test --test-concurrency=1 dist/ui-claude.test.js dist/ui-claude-env.test.js",
    "test:cli-browser": "node --experimental-strip-types --test cli-browser.test.ts",
    "desktop:build": "tsc -p desktop/tsconfig.json",
    "desktop:dev": "npm run build && npm run desktop:build && electron dist-desktop/main.js",
    "desktop:dist": "npm run build && npm run desktop:build && electron-builder --config desktop/electron-builder.yml",
    "desktop:check": "tsc -p desktop/tsconfig.json --noEmit",
    "test:acoes-run": "node --experimental-strip-types --test acoes-run.test.ts",
    "test:acoes-hub": "tsc && node --test dist/ui-acoes-run.test.js",
    "test:g3": "node --experimental-strip-types --test instrucoes.test.ts",
    "test:g3-hub": "tsc && node --test --test-concurrency=1 dist/ui-g3.test.js dist/g3-agente.test.js",
    "test:arvore-projeto": "tsc && node --test dist/ui-arvore-projeto.test.js",
    "test:guarda": "tsc && node --test dist/guarda-escrita.test.js",
    "test:canvas-fases": "node --experimental-strip-types --test canvas-fases.test.ts",
    "test:s1": "tsc && node --test dist/s1-sem-reparo.test.js",
    "test:s2": "tsc && node --test dist/s2-sem-feature.test.js",
    "test:s3": "tsc && node --test dist/s3-dashboard.test.js",
    "test:s4": "tsc && node --test dist/s4-setup.test.js",
    "test:s7": "tsc && node --test dist/s7-gate-timeout.test.js",
    "test:s6": "tsc && node --test dist/s6-pacote.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  }
}
